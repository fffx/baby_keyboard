    "mouse_lock_alert_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Maus oder Trackpad gesperrt sind, drücken Sie Strg + Option + U (⌃⌥U) auf der Tastatur, um zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your mouse or trackpad is locked, press Ctrl + Option + U (⌃⌥U) on your keyboard to unlock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定鼠标或触控板后，请使用键盘快捷键 Ctrl + Option + U (⌃⌥U) 进行解锁。"
          }
        }
      }
    },
